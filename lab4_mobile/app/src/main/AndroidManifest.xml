<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- configChanges keeps the list state when the phone rotates -->
        <activity
            android:name=".Lesson1Activity"
            android:configChanges="orientation|screenSize"
            android:label="@string/lesson1" />
        <activity
            android:name=".Lesson2Activity"
            android:configChanges="orientation|screenSize"
            android:label="@string/lesson2" />
        <activity
            android:name=".Lesson3Activity"
            android:configChanges="orientation|screenSize"
            android:label="@string/lesson3" />
        <activity
            android:name=".Lesson4Activity"
            android:configChanges="orientation|screenSize"
            android:label="@string/lesson4" />
        <activity
            android:name=".Lesson5Activity"
            android:configChanges="orientation|screenSize"
            android:label="@string/users" />
    </application>

</manifest>
